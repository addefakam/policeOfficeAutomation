generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ============ AUTHENTICATION & AUTHORIZATION ============

enum Role {
  ADMIN
  STATION_COMMANDER
  INVESTIGATOR
  CLERK
}

model User {
  id            String   @id @default(cuid())
  username      String   @unique
  passwordHash  String
  role          Role     @default(CLERK)
  officerId     String?  @unique // Link to Officer profile (one-to-one)
  officer       Officer? @relation(fields: [officerId], references: [id])
  isActive      Boolean  @default(true)
  lastLogin     DateTime?
  failedAttempts Int     @default(0)
  lockedUntil   DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  auditLogs     AuditLog[]
  investigationNotes InvestigationNote[]
  caseTeamMembers CaseTeamMember[]
  consultationRequestsSent     ConsultationRequest[] @relation("SentRequests")
  consultationRequestsReceived ConsultationRequest[] @relation("ReceivedRequests")
}

// ============ AUDIT TRAIL ============

model AuditLog {
  id          String   @id @default(cuid())
  userId      String?
  user        User?    @relation(fields: [userId], references: [id])
  username    String   // Denormalized for performance — even if user deleted, log remains
  action      String   // VIEW_CASE, EDIT_CASE, ADD_NOTE, TRANSFER_CASE, CLOSE_CASE, DELETE_CASE, CREATE_USER, LOGIN, LOGOUT, etc.
  modelType   String   // FIR, InvestigationNote, Officer, User, etc.
  objectId    String?  // ID of the affected record
  details     String?  // JSON string with change details
  ipAddress   String?
  userAgent   String?
  timestamp   DateTime @default(now())

  @@index([userId])
  @@index([action])
  @@index([modelType, objectId])
  @@index([timestamp])
}

// ============ MODULE 1: FIR & CASE MANAGEMENT ============

model FIR {
  id            String   @id @default(cuid())
  firNumber     String   @unique
  complainantName String
  complainantPhone String?
  complainantAddress String?
  incidentDate  DateTime
  incidentLocation String
  crimeCategory String
  description   String
  accusedNames  String?
  status        String   @default("Open") // Open, Under Investigation, Closed, Transferred
  assignedTo    String?  // Officer name (backward compat — also in caseTeam)
  priority      String   @default("Medium") // Low, Medium, High, Critical
  station       String   @default("Main Station")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  investigationNotes InvestigationNote[]
  caseTeam      CaseTeamMember[]
  evidenceItems EvidenceItem[]
  consultationRequests ConsultationRequest[]
}

model InvestigationNote {
  id          String   @id @default(cuid())
  firId       String
  fir         FIR      @relation(fields: [firId], references: [id], onDelete: Cascade)
  userId      String?  // Which user added this note (nullable for seed data)
  user        User?    @relation(fields: [userId], references: [id])
  officerName String
  note        String
  actionTaken String?
  createdAt   DateTime @default(now())
  // NO updatedAt — notes are immutable (append-only)
  // No cascade delete — notes persist even if user is deleted
}

// ============ CASE TEAM ============

model CaseTeamMember {
  id          String   @id @default(cuid())
  firId       String
  fir         FIR      @relation(fields: [firId], references: [id], onDelete: Cascade)
  userId      String?
  user        User?    @relation(fields: [userId], references: [id])
  officerName String
  role        String   @default("Lead Investigator") // Lead Investigator, Supporting Investigator, Forensic Analyst, etc.
  addedAt     DateTime @default(now())
  addedBy     String?  // Username of who added this member

  @@unique([firId, userId]) // One role per user per case
  @@index([userId])
}

// ============ CHAIN OF CUSTODY (EVIDENCE) ============

model EvidenceItem {
  id          String   @id @default(cuid())
  firId       String
  fir         FIR      @relation(fields: [firId], references: [id], onDelete: Cascade)
  itemNumber  String   // e.g., EVI-2026-001-01
  description String
  itemType    String   @default("Physical") // Physical, Digital, Documentary, Forensic
  storageLocation String?
  status      String   @default("In Storage") // In Storage, With Investigator, At Lab, In Court, Destroyed
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  custodyChain EvidenceCustody[]
}

model EvidenceCustody {
  id          String   @id @default(cuid())
  evidenceId  String
  evidence    EvidenceItem @relation(fields: [evidenceId], references: [id], onDelete: Cascade)
  receivedBy  String   // Officer/user name
  releasedBy  String?  // Previous custodian
  locationFrom String?
  locationTo  String
  purpose     String?  // e.g., "Forensic analysis", "Court presentation"
  notes       String?
  transferredAt DateTime @default(now())

  @@index([evidenceId])
}

// ============ CONSULTATION REQUESTS ============

model ConsultationRequest {
  id          String   @id @default(cuid())
  firId       String
  fir         FIR      @relation(fields: [firId], references: [id], onDelete: Cascade)
  requestorId String   // User requesting access
  requestor   User     @relation("SentRequests", fields: [requestorId], references: [id])
  responderId String?  // User who owns the case (assigned investigator)
  responder   User?    @relation("ReceivedRequests", fields: [responderId], references: [id])
  reason      String
  status      String   @default("Pending") // Pending, Approved, Rejected, Expired
  grantedAt   DateTime?
  expiresAt   DateTime?
  respondedAt DateTime?
  responseNote String?
  createdAt   DateTime @default(now())

  @@index([requestorId])
  @@index([responderId])
  @@index([status])
}

// ============ MODULE 2: STAFF & DUTY MANAGEMENT ============

model Officer {
  id            String   @id @default(cuid())
  badgeNumber   String   @unique
  name          String
  rank          String   @default("Officer")
  department    String   @default("General Patrol")
  phone         String?
  email         String?
  status        String   @default("Active") // Active, On Leave, Suspended
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  attendances   Attendance[]
  leaveRequests LeaveRequest[]
  dutyAssignments DutyAssignment[]
  userAccount   User?
}

model Attendance {
  id          String   @id @default(cuid())
  officerId   String
  officer     Officer  @relation(fields: [officerId], references: [id], onDelete: Cascade)
  date        DateTime @default(now())
  checkIn     DateTime?
  checkOut    DateTime?
  hoursWorked Float?
  status      String   @default("Present") // Present, Absent, Half Day
  notes       String?
  createdAt   DateTime @default(now())
}

model DutyAssignment {
  id          String   @id @default(cuid())
  officerId   String
  officer     Officer  @relation(fields: [officerId], references: [id], onDelete: Cascade)
  shiftType   String   @default("Day") // Day, Night, Patrol
  postArea    String?
  assignedDate DateTime
  startTime   String?
  endTime     String?
  createdBy   String?
  createdAt   DateTime @default(now())
}

model LeaveRequest {
  id          String   @id @default(cuid())
  officerId   String
  officer     Officer  @relation(fields: [officerId], references: [id], onDelete: Cascade)
  leaveType   String   @default("Annual") // Annual, Sick, Emergency, Maternity
  startDate   DateTime
  endDate     DateTime
  days        Float?
  reason      String?
  status      String   @default("Pending") // Pending, Approved, Rejected
  approvedBy   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// ============ MODULE 3: REPORTING (views built from above data) ============
// Reports are generated dynamically from FIR, Attendance, Officer data

// ============ MODULE 4: VEHICLE & EQUIPMENT TRACKING ============

model Vehicle {
  id              String   @id @default(cuid())
  registrationNumber String @unique
  make            String
  model           String
  year            Int?
  vehicleType     String   @default("Patrol Car")
  status          String   @default("Available") // Available, Assigned, Maintenance, Out of Service
  insuranceExpiry DateTime?
  lastServiceDate DateTime?
  nextServiceDate DateTime?
  currentMileage  Int      @default(0)
  notes           String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  assignments     VehicleAssignment[]
  fuelLogs        FuelLog[]
  maintenanceLogs MaintenanceLog[]
}

model VehicleAssignment {
  id          String   @id @default(cuid())
  vehicleId   String
  vehicle     Vehicle  @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  officerName String?
  officerBadge String?
  purpose     String?
  assignedDate DateTime
  returnDate  DateTime?
  status      String   @default("Assigned") // Assigned, Returned
  createdAt   DateTime @default(now())
}

model FuelLog {
  id          String   @id @default(cuid())
  vehicleId   String
  vehicle     Vehicle  @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  date        DateTime
  fuelType    String   @default("Diesel")
  liters      Float
  cost        Float?
  mileage     Int?
  filledBy    String?
  createdAt   DateTime @default(now())
}

model MaintenanceLog {
  id          String   @id @default(cuid())
  vehicleId   String
  vehicle     Vehicle  @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  maintenanceType String // Routine, Repair, Tire Change, Oil Change
  description String
  cost        Float?
  performedBy String?
  performedDate DateTime
  nextDueDate DateTime?
  status      String   @default("Completed") // Scheduled, In Progress, Completed
  createdAt   DateTime @default(now())
}

model Equipment {
  id            String   @id @default(cuid())
  itemCode      String   @unique
  name          String
  category      String   @default("Communication")
  quantity      Int      @default(1)
  availableQty  Int      @default(1)
  condition     String   @default("Good") // Good, Fair, Poor, Needs Replacement
  storageLocation String?
  lastChecked   DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}